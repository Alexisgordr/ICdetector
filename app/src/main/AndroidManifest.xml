<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions required for monitoring network stats -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- WRITE_SECURE_SETTINGS eliminado en v2.1.
         Era el camino "automático" del fallback de Modo Avión ante 2G/3G, pero nunca se concede
         en una instalación normal (requiere adb), así que en la práctica siempre se ejecutaba la
         rama de reserva: capturar la SecurityException y abrir los ajustes de Modo Avión para que
         lo active la persona. Desde 3.0 tampoco queda el intento de escritura: la notificación de
         red 2G/3G solo ofrece abrir los ajustes de Modo Avión.
         Declarar un permiso privilegiado que no se usa contradice el principio de mínimo
         privilegio que este proyecto dice defender, y es de lo primero que mira cualquiera que
         audite el manifiesto de una app de seguridad. -->

    <!-- Foreground service and notifications.

         La supresión de ForegroundServiceType está acotada a este elemento (v2.1; antes estaba
         desactivada para todo el módulo desde build.gradle.kts). Justificación: el servicio declara
         android:foregroundServiceType="location", tiene FOREGROUND_SERVICE_LOCATION y pasa el tipo
         en startForeground() en Android 14+, así que cumple los requisitos técnicos. Lo que el
         aviso recuerda es la justificación de uso ante la tienda, que es un paso de publicación y
         no de código — y que sigue pendiente mientras la app se distribuya por sideload. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicePermission,ForegroundServiceType" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 3.1.0 — Sin permiso de Internet. La única conexión que quedaba (sonda de latencia, H12) y la
         verificación externa se retiraron. tools:node="remove" lo quita también del manifiesto
         fusionado si alguna dependencia lo declarara. ACCESS_NETWORK_STATE se conserva: solo lee el
         tipo de red (Wi-Fi o datos móviles), que las reglas usan para abstenerse con Wi-Fi. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <!-- Mantiene el bucle de recolección activo con la pantalla apagada. Es un permiso normal:
         no muestra diálogo ni concede acceso adicional a datos. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 3.1.0 (#42) — Arranque tras reiniciar el teléfono, solo si se activa en Ajustes (desactivado
         por defecto) y el monitoreo estaba activado al apagar. Permiso normal, sin diálogo. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- memtagMode="sync" enforces MTE on GrapheneOS / MTE devices to prevent memory corruption attacks -->
    <application
        android:name="com.alexisgordr.icdetector.ICDetectionApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="ICdetection"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:memtagMode="sync"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        tools:targetApi="33">

        <activity
            android:name="com.alexisgordr.icdetector.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 3.0 — Reinicio tras confirmar una restauración (proceso aparte). -->
        <activity
            android:name="com.alexisgordr.icdetector.backup.RestartActivity"
            android:process=":restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name="com.alexisgordr.icdetector.service.MiniICService"
            android:foregroundServiceType="location"
            android:enabled="true"
            android:exported="false"
            tools:ignore="ForegroundServicePermission" />

        <!-- 3.1.0 (#42) — Ver BootStart. Lo envía el sistema: no hace falta exportarlo. -->
        <receiver
            android:name="com.alexisgordr.icdetector.service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
