<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions required for monitoring network stats -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- WRITE_SECURE_SETTINGS eliminado en v2.1.
         Era el camino "automático" del fallback de Modo Avión ante 2G/3G, pero nunca se concede
         en una instalación normal (requiere adb), así que en la práctica siempre se ejecutaba la
         rama de reserva: capturar la SecurityException y abrir los ajustes de Modo Avión para que
         lo active la persona. Esa rama sigue intacta y el comportamiento observable no cambia.
         Declarar un permiso privilegiado que no se usa contradice el principio de mínimo
         privilegio que este proyecto dice defender, y es de lo primero que mira cualquiera que
         audite el manifiesto de una app de seguridad. -->

    <!-- Foreground service and notifications.

         La supresión de ForegroundServiceType está acotada a este elemento (v2.1; antes estaba
         desactivada para todo el módulo desde build.gradle.kts). Justificación: el servicio declara
         android:foregroundServiceType="location", tiene FOREGROUND_SERVICE_LOCATION y pasa el tipo
         en startForeground() en Android 14+, así que cumple los requisitos técnicos. Lo que el
         aviso recuerda es la justificación de uso ante la tienda, que es un paso de publicación y
         no de código — y que sigue pendiente mientras la app se distribuya por sideload. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicePermission,ForegroundServiceType" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- memtagMode="sync" enforces MTE on GrapheneOS / MTE devices to prevent memory corruption attacks -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="ICdetection"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:memtagMode="sync"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        tools:targetApi="31">

        <activity
            android:name="com.alexisgordr.icdetector.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.alexisgordr.icdetector.service.MiniICService"
            android:foregroundServiceType="location"
            android:enabled="true"
            android:exported="false"
            tools:ignore="ForegroundServicePermission" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
